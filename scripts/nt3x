#!/bin/bash
# NET.X launcher
# Usage: nt3x [start|stop|restart|status|logs|install|update|backup|save|reset|open|health]

PROJECT_DIR="/Users/mullvd/Documents/NT3X"
BACKEND_DIR="$PROJECT_DIR/backend"
PANEL_DIR="$PROJECT_DIR/Panel"
BACKEND_PORT=8787
PANEL_PORT=5173
BACKEND_LOG="$PROJECT_DIR/.backend.log"
PANEL_LOG="$PROJECT_DIR/.panel.log"
BACKUP_DIR="$HOME/Documents"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

# ── Utils ──────────────────────────────────────────────────────────────────
log()   { echo -e "  ${CYAN}→${NC} $*"; }
ok()    { echo -e "  ${GREEN}✓${NC} $*"; }
warn()  { echo -e "  ${YELLOW}!${NC} $*"; }
err()   { echo -e "  ${RED}✗${NC} $*"; }

kill_port() {
  local port=$1
  local pids
  pids=$(lsof -ti:"$port" 2>/dev/null)
  if [ -n "$pids" ]; then
    echo "$pids" | xargs kill -9 2>/dev/null
    return 0
  fi
  return 1
}

ensure_project() {
  if [ ! -d "$PROJECT_DIR" ]; then
    err "Projet introuvable : $PROJECT_DIR"
    exit 1
  fi
}

ensure_deps() {
  if [ ! -d "$BACKEND_DIR/node_modules" ] || [ ! -d "$PANEL_DIR/node_modules" ]; then
    warn "Dépendances manquantes — installation automatique..."
    install_deps
  fi
}

ensure_env() {
  if [ ! -f "$BACKEND_DIR/.env" ]; then
    warn "Backend .env manquant"
    if [ -f "$BACKEND_DIR/.env.example" ]; then
      log "Copie de .env.example vers .env"
      cp "$BACKEND_DIR/.env.example" "$BACKEND_DIR/.env"
      err "Édite $BACKEND_DIR/.env avant de relancer (API_TOKEN obligatoire)"
      exit 1
    fi
  fi
  if [ ! -f "$PANEL_DIR/.env.local" ]; then
    warn "Panel .env.local manquant"
    if [ -f "$PANEL_DIR/.env.example" ]; then
      log "Copie de .env.example vers .env.local"
      cp "$PANEL_DIR/.env.example" "$PANEL_DIR/.env.local"
      err "Édite $PANEL_DIR/.env.local avant de relancer (VITE_WATCHER_API_TOKEN identique au backend)"
      exit 1
    fi
  fi
}

# ── Commandes ──────────────────────────────────────────────────────────────
install_deps() {
  ensure_project
  echo -e "${CYAN}${BOLD}Installation des dépendances NET.X${NC}"
  if ! command -v npm >/dev/null 2>&1; then
    err "npm introuvable. Installe Node.js (https://nodejs.org)."
    exit 1
  fi
  log "Backend (npm install)..."
  (cd "$BACKEND_DIR" && npm install) || { err "Échec backend"; exit 1; }
  log "Panel (npm install)..."
  (cd "$PANEL_DIR"   && npm install) || { err "Échec panel"; exit 1; }
  ok "Dépendances installées."
}

update_deps() {
  ensure_project
  echo -e "${CYAN}${BOLD}Mise à jour des dépendances${NC}"
  log "Backend (npm install)..."
  (cd "$BACKEND_DIR" && npm install) || { err "Échec backend"; exit 1; }
  log "Panel (npm install)..."
  (cd "$PANEL_DIR"   && npm install) || { err "Échec panel"; exit 1; }
  ok "Dépendances à jour."
}

stop_all() {
  echo -e "${YELLOW}${BOLD}Arrêt de NET.X${NC}"
  if kill_port $BACKEND_PORT; then ok "Backend arrêté (port $BACKEND_PORT)"
  else                              err "Backend déjà arrêté"
  fi
  if kill_port $PANEL_PORT; then    ok "Panel arrêté (port $PANEL_PORT)"
  else                              err "Panel déjà arrêté"
  fi
  pkill -f "tsx watch src/index.ts" 2>/dev/null
  pkill -f "vite" 2>/dev/null
  sleep 1
}

start_all() {
  ensure_project
  ensure_env
  ensure_deps
  echo -e "${CYAN}${BOLD}Démarrage de NET.X${NC}"

  if lsof -ti:$BACKEND_PORT >/dev/null 2>&1; then
    warn "Port $BACKEND_PORT occupé, libération..."
    kill_port $BACKEND_PORT; sleep 1
  fi
  log "Lancement backend..."
  (cd "$BACKEND_DIR" && nohup npm run dev > "$BACKEND_LOG" 2>&1 &) >/dev/null 2>&1

  if lsof -ti:$PANEL_PORT >/dev/null 2>&1; then
    warn "Port $PANEL_PORT occupé, libération..."
    kill_port $PANEL_PORT; sleep 1
  fi
  log "Lancement panel..."
  (cd "$PANEL_DIR" && nohup npm run dev > "$PANEL_LOG" 2>&1 &) >/dev/null 2>&1

  log "Attente du démarrage..."
  for i in {1..20}; do
    if lsof -ti:$BACKEND_PORT >/dev/null 2>&1 && lsof -ti:$PANEL_PORT >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done

  echo ""
  status_all
  echo ""
  echo -e "${GREEN}${BOLD}NET.X est lancé${NC}"
  echo -e "  Backend : ${CYAN}http://localhost:$BACKEND_PORT${NC}"
  echo -e "  Panel   : ${CYAN}http://localhost:$PANEL_PORT${NC}"
  echo ""
  echo -e "${DIM}Commandes utiles :${NC}"
  echo -e "  ${YELLOW}nt3x logs${NC}    suivre les logs"
  echo -e "  ${YELLOW}nt3x open${NC}    ouvrir le panel dans le navigateur"
  echo -e "  ${YELLOW}nt3x stop${NC}    tout arrêter"
}

status_all() {
  ensure_project
  echo -e "${CYAN}${BOLD}Statut NET.X${NC}"
  if lsof -ti:$BACKEND_PORT >/dev/null 2>&1; then
    echo -e "  Backend : ${GREEN}● running${NC} (port $BACKEND_PORT)"
  else
    echo -e "  Backend : ${RED}○ stopped${NC}"
  fi
  if lsof -ti:$PANEL_PORT >/dev/null 2>&1; then
    echo -e "  Panel   : ${GREEN}● running${NC} (port $PANEL_PORT)"
  else
    echo -e "  Panel   : ${RED}○ stopped${NC}"
  fi
  if [ -f "$BACKEND_DIR/data.sqlite" ]; then
    local size=$(du -h "$BACKEND_DIR/data.sqlite" | cut -f1)
    echo -e "  DB      : ${DIM}$size${NC}"
  fi
}

show_logs() {
  ensure_project
  local target="${1:-all}"
  case "$target" in
    backend|back|b) echo -e "${CYAN}Logs backend (Ctrl+C pour quitter) :${NC}"; tail -f "$BACKEND_LOG" ;;
    panel|p)        echo -e "${CYAN}Logs panel (Ctrl+C pour quitter) :${NC}";   tail -f "$PANEL_LOG" ;;
    *)              echo -e "${CYAN}Logs (Ctrl+C pour quitter) :${NC}";        tail -f "$BACKEND_LOG" "$PANEL_LOG" ;;
  esac
}

health_check() {
  ensure_project
  echo -e "${CYAN}${BOLD}Health check${NC}"
  local api_token
  api_token=$(grep '^API_TOKEN' "$BACKEND_DIR/.env" 2>/dev/null | cut -d= -f2 | tr -d '"')
  if [ -z "$api_token" ]; then
    err "API_TOKEN introuvable dans backend/.env"
    return 1
  fi
  log "Test backend..."
  local resp
  resp=$(curl -s -m 3 -w "%{http_code}" -o /tmp/.nt3x-health "http://localhost:$BACKEND_PORT/api/status" -H "Authorization: Bearer $api_token")
  if [ "$resp" = "200" ]; then
    local accs gs evs
    accs=$(grep -o '"ready_accounts":[0-9]*' /tmp/.nt3x-health | cut -d: -f2)
    gs=$(grep -o '"total_guilds":[0-9]*'    /tmp/.nt3x-health | cut -d: -f2)
    evs=$(grep -o '"watched":[0-9]*'         /tmp/.nt3x-health | cut -d: -f2)
    ok "Backend OK — comptes prêts: $accs, serveurs: $gs, cibles: $evs"
  else
    err "Backend KO (HTTP $resp)"
  fi
  log "Test panel..."
  if curl -s -m 3 -o /dev/null -w "%{http_code}" "http://localhost:$PANEL_PORT/" | grep -q "200"; then
    ok "Panel OK"
  else
    err "Panel KO"
  fi
  rm -f /tmp/.nt3x-health
}

git_save() {
  ensure_project
  cd "$PROJECT_DIR" || exit 1
  if [ ! -d ".git" ]; then
    log "Initialisation git..."
    git init -q -b main
  fi
  if [ -z "$(git status --porcelain 2>/dev/null)" ]; then
    warn "Rien à commiter"
    git log --oneline | head -5
    return 0
  fi
  local msg="${1:-snapshot $(date +%Y-%m-%d_%H%M)}"
  git add -A
  git -c user.name=Mullvd -c user.email=mullvd@local.dev commit -m "$msg" -q
  ok "Commit : $msg"
  git log --oneline | head -5
}

backup_archive() {
  ensure_project
  mkdir -p "$BACKUP_DIR"
  local stamp
  stamp=$(date +%Y-%m-%d_%H%M)
  local archive="$BACKUP_DIR/NT3X-backup-$stamp.tar.gz"
  log "Création de l'archive..."
  tar --exclude='*/node_modules' \
      --exclude='*.log' \
      --exclude='*/dist' \
      --exclude='*/build' \
      --exclude='.DS_Store' \
      -czf "$archive" \
      -C "$(dirname "$PROJECT_DIR")" "$(basename "$PROJECT_DIR")" || { err "Échec archive"; exit 1; }
  local size
  size=$(du -h "$archive" | cut -f1)
  ok "Sauvegarde créée : $archive ($size)"
  echo ""
  echo -e "${DIM}Pour restaurer :${NC}"
  echo -e "  tar -xzf $archive -C $HOME/Documents/"
  echo -e "  cd $(basename "$PROJECT_DIR") && nt3x install"
}

reset_db() {
  ensure_project
  echo -e "${YELLOW}${BOLD}Reset de la base events${NC}"
  echo -e "Cela ${RED}supprime tous les events enregistrés${NC} (les comptes/cibles sont conservés)."
  read -r -p "Confirmer ? [y/N] " confirm
  if [[ "$confirm" =~ ^[yY]$ ]]; then
    sqlite3 "$BACKEND_DIR/data.sqlite" "DELETE FROM events; VACUUM;" 2>/dev/null && ok "Events supprimés"
    if lsof -ti:$BACKEND_PORT >/dev/null 2>&1; then
      log "Redémarrage backend pour rafraîchir les caches..."
      kill_port $BACKEND_PORT; sleep 1
      (cd "$BACKEND_DIR" && nohup npm run dev > "$BACKEND_LOG" 2>&1 &) >/dev/null 2>&1
    fi
  else
    warn "Annulé."
  fi
}

open_panel() {
  ensure_project
  if ! lsof -ti:$PANEL_PORT >/dev/null 2>&1; then
    warn "Panel non démarré, lancement..."
    start_all
  fi
  open "http://localhost:$PANEL_PORT/"
}

usage() {
  echo -e "
${BOLD}NET.X — launcher${NC}
Usage : nt3x <commande>

${CYAN}Cycle de vie${NC}
  start            démarre backend + panel
  stop             arrête tout
  restart          stop + start
  status           affiche le statut
  health           ping backend + panel pour vérifier qu'ils répondent

${CYAN}Logs${NC}
  logs             tail -f sur les deux logs
  logs backend     log backend uniquement
  logs panel       log panel uniquement

${CYAN}Maintenance${NC}
  install          npm install dans backend + panel
  update           refresh des dépendances (alias install)
  reset            vide la table events (interactif)
  open             ouvre le panel dans le navigateur

${CYAN}Sauvegarde${NC}
  save [msg]       commit git rapide ('snapshot HH:MM' par défaut)
  backup           crée un .tar.gz daté dans ~/Documents/

"
}

# ── Dispatch ───────────────────────────────────────────────────────────────
case "${1:-start}" in
  start)            start_all ;;
  stop)             stop_all ;;
  restart)          stop_all; start_all ;;
  status|st)        status_all ;;
  health|ping)      health_check ;;
  logs|log)         shift; show_logs "$@" ;;
  install)          install_deps ;;
  update)           update_deps ;;
  backup)           backup_archive ;;
  save|commit)      shift; git_save "$@" ;;
  reset)            reset_db ;;
  open)             open_panel ;;
  help|-h|--help)   usage ;;
  *)
    echo "Commande inconnue : $1"
    echo ""
    usage
    exit 1
    ;;
esac
