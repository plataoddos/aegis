#!/bin/bash
# NET.X launcher — démarre backend + panel
# Usage: n3tx [start|stop|restart|status|logs]

PROJECT_DIR="/Users/emanuel/Documents/NT3X"
BACKEND_DIR="$PROJECT_DIR/backend"
PANEL_DIR="$PROJECT_DIR/Panel"
BACKEND_PORT=8787
PANEL_PORT=5173
BACKEND_LOG="$PROJECT_DIR/.backend.log"
PANEL_LOG="$PROJECT_DIR/.panel.log"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

kill_port() {
  local port=$1
  local pids
  pids=$(lsof -ti:"$port" 2>/dev/null)
  if [ -n "$pids" ]; then
    echo "$pids" | xargs kill -9 2>/dev/null
    return 0
  fi
  return 1
}

stop_all() {
  echo -e "${YELLOW}Arrêt de NET.X...${NC}"
  if kill_port $BACKEND_PORT; then
    echo -e "  ${GREEN}✓${NC} Backend arrêté (port $BACKEND_PORT)"
  else
    echo -e "  ${RED}-${NC} Backend déjà arrêté"
  fi
  if kill_port $PANEL_PORT; then
    echo -e "  ${GREEN}✓${NC} Panel arrêté (port $PANEL_PORT)"
  else
    echo -e "  ${RED}-${NC} Panel déjà arrêté"
  fi
  pkill -f "tsx watch src/index.ts" 2>/dev/null
  pkill -f "vite" 2>/dev/null
  sleep 1
}

start_all() {
  echo -e "${CYAN}Démarrage de NET.X...${NC}"

  # Backend
  if lsof -ti:$BACKEND_PORT >/dev/null 2>&1; then
    echo -e "  ${YELLOW}!${NC} Port $BACKEND_PORT occupé, libération..."
    kill_port $BACKEND_PORT
    sleep 1
  fi
  echo -e "  ${CYAN}→${NC} Lancement backend..."
  (cd "$BACKEND_DIR" && nohup npm run dev > "$BACKEND_LOG" 2>&1 &)

  # Panel
  if lsof -ti:$PANEL_PORT >/dev/null 2>&1; then
    echo -e "  ${YELLOW}!${NC} Port $PANEL_PORT occupé, libération..."
    kill_port $PANEL_PORT
    sleep 1
  fi
  echo -e "  ${CYAN}→${NC} Lancement panel..."
  (cd "$PANEL_DIR" && nohup npm run dev > "$PANEL_LOG" 2>&1 &)

  # Attendre que les serveurs montent
  echo -e "  ${CYAN}→${NC} Attente du démarrage..."
  for i in {1..15}; do
    if lsof -ti:$BACKEND_PORT >/dev/null 2>&1 && lsof -ti:$PANEL_PORT >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done

  echo ""
  status_all
  echo ""
  echo -e "${GREEN}NET.X est lancé :${NC}"
  echo -e "  Backend : ${CYAN}http://localhost:$BACKEND_PORT${NC}"
  echo -e "  Panel   : ${CYAN}http://localhost:$PANEL_PORT${NC}"
  echo ""
  echo -e "Logs : ${YELLOW}n3tx logs${NC}  |  Stop : ${YELLOW}n3tx stop${NC}"
}

status_all() {
  echo -e "${CYAN}Statut NET.X :${NC}"
  if lsof -ti:$BACKEND_PORT >/dev/null 2>&1; then
    echo -e "  Backend : ${GREEN}● running${NC} (port $BACKEND_PORT)"
  else
    echo -e "  Backend : ${RED}○ stopped${NC}"
  fi
  if lsof -ti:$PANEL_PORT >/dev/null 2>&1; then
    echo -e "  Panel   : ${GREEN}● running${NC} (port $PANEL_PORT)"
  else
    echo -e "  Panel   : ${RED}○ stopped${NC}"
  fi
}

show_logs() {
  echo -e "${CYAN}Logs (Ctrl+C pour quitter) :${NC}"
  tail -f "$BACKEND_LOG" "$PANEL_LOG"
}

case "${1:-start}" in
  start)   start_all ;;
  stop)    stop_all ;;
  restart) stop_all; start_all ;;
  status)  status_all ;;
  logs)    show_logs ;;
  *)
    echo "Usage: n3tx [start|stop|restart|status|logs]"
    exit 1
    ;;
esac
