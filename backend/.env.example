# ──────────────────────────────────────────────────────────────────────────
# ⚠️  WARNING: this backend uses USER tokens (selfbot accounts), not bot tokens.
#     This is a Discord ToS violation and the accounts can be banned.
#     Only use throwaway accounts you don't care about.
# ──────────────────────────────────────────────────────────────────────────

# Shared secret for the panel (Bearer auth header)
# Plus besoin d'API_TOKEN : l'auth est désormais user-based via /api/auth.
# Le premier compte créé devient admin automatiquement.
# WS_TOKEN= # optionnel, pour clients WebSocket externes (CLI legacy)

# Where the API listens
PORT=8787

# Comma-separated list of allowed CORS origins.
# REQUIRED in production (NODE_ENV=production) — the backend refuses to boot otherwise.
ALLOWED_ORIGINS=http://localhost:5173

# Master key for at-rest encryption (Discord selfbot tokens).
# Use either hex (≥64 chars) or base64 (≥44 chars), 32 bytes raw.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, an auto-generated key is persisted at backend/data/.master_key (chmod 600).
# MASTER_KEY=

# Tokens are now stored in data.sqlite — manage them via the admin panel.

# BrixHub API (https://brixhub.net) — clé brix_xxxxxxxx
BRIX_API_KEY=
BRIX_BASE_URL=https://brixhub.net/api/v1
BRIX_CACHE_TTL_MS=86400000
BRIX_USER_AGENT=Aegis-Panel/1.0
# Legacy fallback (les anciennes variables SEEK_* sont toujours acceptées).
